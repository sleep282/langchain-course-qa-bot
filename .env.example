# ===== 在线大模型配置（OpenAI 兼容接口）=====
# 复制本文件为 .env 并填入你自己的 Key

# --- 方案 A：DeepSeek（推荐，便宜，国内直连）---
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- 方案 B：火山方舟 豆包 ---
# LLM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxxxxxxxx   # 填入你的接入点 ID

# --- 方案 C：OpenAI 官方 ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- 方案 D：月之暗面 Kimi / 通义千问等，同理改 base_url 和 model 即可 ---

# 生成温度（0~1，越小越稳定）
TEMPERATURE=0.3

# 检索时返回的相关文档片段数量
RETRIEVER_K=3
